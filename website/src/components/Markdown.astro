---
// A small working model of the editor: each line keeps its Markdown syntax,
// and the syntax only shows on the line the caret is on (README › The editor).
// The text is the demo vault's auth/auth-flow.md.
import type { Copy } from '../content/en';

interface Props { copy: Copy }
const { copy } = Astro.props;
const t = copy.markdown;
---

<section class="md section" id={t.id} aria-labelledby="md-h">
  <div class="wrap split">
    <div class="text l">
      <h2 class="h2" id="md-h">{t.title}</h2>
      <div class="prose">
        {t.body.map((p) => <p>{p}</p>)}
      </div>
      <ul class="facts">
        {t.facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>

    <figure class="demo r">
      <div class="sheet" data-sheet>
        <p class="file label"><span class="spine-dot" aria-hidden="true"></span>{t.demoFile}</p>
        <div class="lines" role="group" aria-label={t.demoLabel}>
          <p class="ln l1" tabindex="-1"><span class="syn"># </span>Auth Flow</p>
          <p class="ln" tabindex="-1">Tokens are minted <span class="syn">**</span><strong>once</strong><span class="syn">**</span> and cached locally. The storage layer is covered in <span class="syn">[[</span><span class="wl-d">adapter-design</span><span class="syn">]]</span>.</p>
          <p class="ln l2" tabindex="0" data-caret><span class="syn">## </span>Token exchange</p>
          <p class="ln" tabindex="-1">Session state lives in <span class="syn">`</span><code class="chip-d">TokenStore</code><span class="syn">`</span> and is rebuilt on launch.</p>
          <p class="ln l2" tabindex="-1"><span class="syn">## </span>Open items</p>
          <p class="ln task done" tabindex="-1"><span class="syn">- [x] </span><span class="box on" aria-hidden="true"></span><s>Refresh rotation on 401</s></p>
          <p class="ln task" tabindex="-1"><span class="syn">- [ ] </span><span class="box" aria-hidden="true"></span>Offline grace period — 72h?</p>
          <p class="ln quote" tabindex="-1"><span class="syn">&gt; </span>The gateway is the only component allowed to see the client secret.</p>
        </div>
      </div>
      <figcaption class="figcode">
        <span class="cap">{t.demoLabel}</span>
        <span class="label">{t.demoFig}</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // the caret follows the pointer and the keyboard; CSS does the folding
  for (const sheet of document.querySelectorAll<HTMLElement>('[data-sheet]')) {
    const move = (line: Element | null) => {
      if (!line) return;
      sheet.querySelector('[data-caret]')?.removeAttribute('data-caret');
      line.setAttribute('data-caret', '');
    };
    sheet.addEventListener('pointerover', (e) => move((e.target as Element).closest('.ln')));
    // one tab stop for the whole note (the caret line); arrows walk the lines
    sheet.addEventListener('focusin', (e) => {
      const line = (e.target as Element).closest('.ln');
      if (!line) return;
      for (const l of sheet.querySelectorAll<HTMLElement>('.ln')) l.tabIndex = l === line ? 0 : -1;
      move(line);
    });
    sheet.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const line = (e.target as Element).closest('.ln');
      const next = e.key === 'ArrowDown' ? line?.nextElementSibling : line?.previousElementSibling;
      if (next instanceof HTMLElement) {
        e.preventDefault();
        next.focus();
      }
    });
  }
</script>

<style>
  .md { padding-top: var(--sp-10); }
  .text .prose { margin-top: var(--sp-6); }
  .facts {
    margin-top: var(--sp-6);
    display: grid;
    gap: var(--sp-2);
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    color: var(--ink-2);
  }
  .facts li { padding-left: 1.4em; position: relative; }
  .facts li::before { content: '→'; position: absolute; left: 0; color: var(--accent); }

  .demo { margin-top: var(--sp-9); }
  .sheet {
    position: relative;
    background: var(--surface-panel);
    border: 1px solid var(--line);
    padding: var(--sp-5) var(--sp-6) var(--sp-6) var(--sp-7);
    font-family: var(--f-mono);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink);
  }
  /* the colour line: the note's colour, down the gutter */
  .sheet::before {
    content: '';
    position: absolute;
    left: var(--sp-5);
    top: 0;
    bottom: 0;
    width: var(--spine-w);
    background: var(--doc-1);
  }
  .file {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    margin-bottom: var(--sp-4);
  }
  .spine-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--doc-1); }

  .ln {
    position: relative;
    margin: 0 calc(var(--sp-3) * -1);
    padding: 3px var(--sp-3);
    border-radius: var(--radius-1);
    cursor: text;
    outline: none;
  }
  .ln + .ln { margin-top: 2px; }
  .ln:focus-visible { box-shadow: inset 0 0 0 1px var(--accent); }
  .ln[data-caret] { background: var(--surface-raised); }
  /* folded syntax: present in the file, absent on screen, back under the caret */
  .syn { display: none; color: var(--ink-3); }
  .ln[data-caret] .syn { display: inline; }
  .ln[data-caret]::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ln[data-caret]::after { animation: blink 1.1s steps(1) infinite; }
  }
  @keyframes blink { 50% { opacity: 0; } }

  .l1 { font-size: 1.5rem; font-weight: 700; line-height: 1.4; }
  .l2 { font-size: 1.0625rem; font-weight: 700; margin-top: var(--sp-3); }
  strong { font-weight: 700; }
  .wl-d {
    color: var(--accent);
    text-decoration: underline dashed;
    text-underline-offset: 0.2em;
  }
  .chip-d {
    font-size: 0.9em;
    padding: 0 0.3em;
    border: 1px solid var(--line);
    background: var(--surface-inset);
    border-radius: var(--radius-1);
  }
  .task { display: flex; align-items: baseline; gap: 0.6em; }
  .task .syn { margin-right: -0.6em; }
  .ln[data-caret] .box { display: none; }
  .box {
    flex: none;
    width: 0.8em;
    height: 0.8em;
    border: 1px solid var(--ink-3);
    border-radius: 2px;
    transform: translateY(0.08em);
  }
  .box.on { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 2px var(--surface-panel); }
  .done s { color: var(--ink-3); }
  .quote { color: var(--ink-2); border-left: 2px solid var(--line-2); padding-left: var(--sp-4); margin-left: 0; }
  .quote[data-caret] { border-left-color: var(--line-2); }

  .figcode .cap { font-size: var(--fs-small); color: var(--ink-2); }

  @media (max-width: 960px) {
    .demo { margin-top: 0; }
  }
  @media (max-width: 560px) {
    .sheet { padding: var(--sp-4) var(--sp-4) var(--sp-5) var(--sp-6); font-size: 0.875rem; }
    .sheet::before { left: var(--sp-3); }
    .figcode { flex-direction: column; gap: var(--sp-1); }
  }
</style>
